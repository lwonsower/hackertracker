# Copy to .env.local — secrets. Git-ignored; never commit it.
#
# The server reads this at startup, so there is no need to `export` anything.
# A real environment variable always wins over this file, so CI or a one-off
# shell override still works without editing it.

# ── sign-in ──────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add the redirect URL
# below to its authorised redirect URIs, character for character.
#
# Port 5173 is deliberate: in development the browser only talks to Vite, which
# proxies /api to the Go server. Use your real origin when deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/google/callback

# Skips Google entirely and signs in as this address. Self-host mode only, and
# every use is logged loudly. Leave empty once Google sign-in works.
DEV_SIGN_IN_EMAIL=

# ── credentials encryption ───────────────────────────────────────────────
# Encrypts per-account connector tokens at rest. Format id:base64key, 32-byte
# key. Generate with:
#     echo "v1:$(openssl rand -base64 32)"
# Extra comma-separated keys are decrypt-only, so a key can be rotated.
CREDENTIALS_KEY=

# ── connectors ───────────────────────────────────────────────────────────
# In the Sources panel you enter the variable NAME (GITHUB_TOKEN), never the
# token itself. Only usable in self-host mode: with several accounts, a shared
# variable would let one account read another's GitHub data.
GITHUB_TOKEN=

# For GitHub Enterprise Server only.
# GITHUB_API_BASE_URL=https://github.example.com/api/v3
