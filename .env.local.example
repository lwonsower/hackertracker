# Copy to .env.local — secrets. Git-ignored; never commit it.
#
# The server reads this at startup, so there is no need to `export` anything.
# A real environment variable always wins over this file, so CI or a one-off
# shell override still works without editing it.
#
# In the Sources panel you enter the variable NAME (GITHUB_TOKEN), never the
# token itself. The token lives here and nowhere else.

GITHUB_TOKEN=

# For GitHub Enterprise Server only.
# GITHUB_API_BASE_URL=https://github.example.com/api/v3
