# Copy to .env and adjust. Compose reads this file automatically.
POSTGRES_USER=hackertracker
POSTGRES_PASSWORD=hackertracker
POSTGRES_DB=hackertracker
POSTGRES_PORT=5432

# Used by the Go server when run on the host (npm run dev).
DATABASE_URL=postgres://hackertracker:hackertracker@localhost:5432/hackertracker?sslmode=disable
