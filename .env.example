# Copy to .env — non-secret local configuration.
#
# Compose reads this file natively for the substitutions in docker-compose.yml.
# Secrets do NOT belong here; put those in .env.local instead.

POSTGRES_USER=hackertracker
POSTGRES_PASSWORD=hackertracker
POSTGRES_DB=hackertracker

# Deliberately not 5432, so it cannot collide with another Postgres you run.
POSTGRES_PORT=5442

# self-host (default) allows one adopted account, environment-variable
# credentials, and the developer sign-in bypass. hosted disables all three.
DEPLOYMENT_MODE=self-host

# Session cookies are marked Secure automatically when hosted; set explicitly
# to override. Must be false for plain-HTTP local development.
# COOKIE_SECURE=false

# Used by the Go server when run on the host (npm run dev).
DATABASE_URL=postgres://hackertracker:hackertracker@localhost:5442/hackertracker?sslmode=disable
